# Frontend origin for CORS (must match the URL users access the frontend on)
FRONTEND_ORIGIN=http://localhost:3000

# Port mappings for docker-compose
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend workers (default: 2)
WORKERS=2

# Log format: "text" (default) or "json" (for log aggregation)
# LOG_FORMAT=json

# Hive Moderation API key (optional — improves detection accuracy)
# Get a free key at https://thehive.ai
HIVE_API_KEY=

# WhatsApp Bot (optional — requires Twilio account)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# DETECTOR_API_URL=http://backend:8000
# BOT_PORT=5001
